{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TZ": "Europe/Berlin"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit(_posts/**)",
      "Write(_posts/**)",
      "Bash(date:*)",
      "Bash(TZ=Europe/Berlin date:*)",
      "Bash(ls:*)",
      "Bash(python3 scripts/check_posts.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add _posts/:*)",
      "Bash(git commit:*)",
      "Bash(git pull --rebase origin main)",
      "Bash(git push origin HEAD:main)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(_layouts/**)",
      "Edit(_includes/**)",
      "Edit(assets/**)",
      "Edit(ROUTINE.md)",
      "Edit(_config.yml)",
      "Write(.github/**)",
      "Write(.claude/**)",
      "Write(scripts/**)",
      "Write(_layouts/**)",
      "Write(_includes/**)",
      "Write(assets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
