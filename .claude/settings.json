{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TZ": "Europe/Berlin"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit(_posts/**)",
      "Write(_posts/**)",
      "Bash(date:*)",
      "Bash(TZ=Europe/Berlin date:*)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add _posts/:*)",
      "Bash(git commit:*)",
      "Bash(git pull --rebase origin main:*)",
      "Bash(git push origin HEAD:main)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
